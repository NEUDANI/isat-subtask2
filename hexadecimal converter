int hexadecimalToDecimal(string hexadecimal)
{
    int decimal = 0;

    for (int i = 0; i < hexadecimal.length(); i++)
    {
        char digit = hexadecimal[i];
        int value;

        if (digit >= '0' && digit <= '9')
            value = digit - '0';
        else if (digit >= 'A' && digit <= 'F')
            value = digit - 'A' + 10;
        else
            value = digit - 'a' + 10;

        decimal = decimal * 16 + value;
    }

    return decimal;
}
