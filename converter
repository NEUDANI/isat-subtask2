#include <iostream>
#include <string>
using namespace std;

string decimalToBinary(int decimal) {
    if (decimal == 0) return "0";
    string binary = "";
    while (decimal > 0) {
        int remainder = decimal % 2;
        binary = to_string(remainder) + binary;
        decimal = decimal / 2;
    }
    return binary;
}
int main() {
    int num = 10;
    cout << decimalToBinary(num) << endl;
    return 0;
}
